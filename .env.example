# Groq API Configuration (Free tier: get your free key at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_GENERATION_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY = your_openrouter_api_key_here
OPENROUTER_MODEL_NAME = minimax/minimax-m3:free

# Pipeline Parameters
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
RERANKER_MODEL_NAME=BAAI/bge-reranker-base
CONFIDENCE_THRESHOLD=0.35
CHILD_CHUNK_TARGET_TOKENS=500
PARENT_CHUNK_MAX_TOKENS=2000
